        zoneSvg.appendChild(line);
        const label=document.createElementNS('http://www.w3.org/2000/svg','text');
        label.setAttribute('x','6'); label.setAttribute('y',y-6); label.setAttribute('fill',z.color); label.setAttribute('font-size','9'); label.setAttribute('font-weight','700');
        label.textContent=`${z.type} ${z.price.toFixed(2)}`;
        zoneSvg.appendChild(label);
      }catch(e){}
    });
    let x1=null,y1=null,x2=null,y2=null;
    try{
      const lastTime=data[data.length-1].time;
      x1=chart.timeScale().timeToCoordinate(lastTime);
      y1=candleSeries.priceToCoordinate(pred.reference);
      x2=chart.timeScale().timeToCoordinate(pred.predictedPath[1].time);
      y2=candleSeries.priceToCoordinate(pred.destination);
    }catch(e){}
    if(x1===null||y1===null){ x1=120; y1=200; }
    if(x2===null||y2===null){ x2=x1+280; y2=y1 + (pred.direction==='BULLISH'? -90:90); }
    const midX=x1 + (x2-x1)*0.5;
    const midY=y1 + (y2-y1)*0.2;
    const d=`M ${x1} ${y1} Q ${midX+80} ${midY+40} ${x2} ${y2}`;
    const defs=document.createElementNS('http://www.w3.org/2000/svg','defs');
    const marker=document.createElementNS('http://www.w3.org/2000/svg','marker'); marker.setAttribute('id','predArrowLive'); marker.setAttribute('markerWidth','10'); marker.setAttribute('markerHeight','8'); marker.setAttribute('refX','9'); marker.setAttribute('refY','4'); marker.setAttribute('orient','auto');
