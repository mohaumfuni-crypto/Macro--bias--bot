      ...state.bsl.slice(-1).map(b=>({price:b.price, type:b.type, color:'#38bdf8', dash:'8 6', width:'1.2'})),
      ...state.ssl.slice(-1).map(s=>({price:s.price, type:s.type, color:'#FF3B30', dash:'8 6', width:'1.2'})),
