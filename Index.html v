// ===== LIVE DATA PROVIDER LAYER — BINANCE ONLY — NO FAKE FALLBACK =====
class BinanceProvider{
  constructor(symbol){
    this.symbol=symbol;
    this.base='https://api.binance.com';
    this.ws=null;
    this.latency=null;
  }
  async fetchKlines(interval='1m', limit=500){
    const start=Date.now();
    try{
      const res=await fetch(`${this.base}/api/v3/klines?symbol=${this.symbol}&interval=${interval}&limit=${limit}`);
      const data=await res.json();
      const parsed=data.filter(d=>d&&d.length>=5).map(d=>({time:Math.floor(d[0]/1000), open:parseFloat(d[1]), high:parseFloat(d[2]), low:parseFloat(d[3]), close:parseFloat(d[4]), volume:parseFloat(d[5]), source:'BINANCE', symbol:this.symbol, interval, timestamp:new Date().toISOString(), provenance:`REST ${this.base}/api/v3/klines ${this.symbol} ${interval}`})).filter(c=>typeof c.close==='number'&&!isNaN(c.close));
      this.latency=Date.now()-start;
      return parsed;
    }catch(e){
      this.latency=null;
      throw e;
    }
  }
  connectWS(onCandle){
    try{
      const ws=new WebSocket(`wss://stream.binance.com:9443/ws/${this.symbol.toLowerCase()}@kline_1m`);
      ws.onopen=()=>{ connStatus[selectedInstr==='PAXGUSDT'?'PAXGUSDT':'BTCUSDT']='CONNECTED'; dataProvenance[selectedInstr==='PAXGUSDT'?'PAXGUSDT':'BTCUSDT'].status='CONNECTED'; document.getElementById('connInfo').textContent='CONNECTED'; isLive=true; isDegraded=false; document.getElementById('pausedOverlay').style.display='none'; };
      ws.onmessage=(e)=>{
        try{
          const msg=JSON.parse(e.data); const k=msg.k; if(!k) return;
          const c={time:Math.floor(k.t/1000), open:parseFloat(k.o), high:parseFloat(k.h), low:parseFloat(k.l), close:parseFloat(k.c), volume:parseFloat(k.v), source:'BINANCE', symbol:this.symbol, interval:'1m', timestamp:new Date().toISOString(), provenance:`WS ${this.symbol}@kline_1m`};
          if(isNaN(c.close)) return;
          onCandle(c);
        }catch(err){}
      };
      ws.onclose=()=>{ connStatus[this.symbol]='RECONNECTING'; dataProvenance[this.symbol].status='RECONNECTING'; document.getElementById('connInfo').textContent='RECONNECTING — LIVE DATA RESTORED REASSESSING MARKET on reconnect'; setTimeout(()=>this.connectWS(onCandle),3000); };
      this.ws=ws;
    }catch(e){ connStatus[this.symbol]='DISCONNECTED'; isLive=false; }
  }
}

