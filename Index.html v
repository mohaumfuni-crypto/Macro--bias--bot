    pathSvg.appendChild(path);
    for(let i=0.2;i<1;i+=0.2){
      const t=i; const xt=(1-t)*(1-t)*x1 + 2*(1-t)*t*(midX+80) + t*t*x2; const yt=(1-t)*(1-t)*y1 + 2*(1-t)*t*(midY+40) + t*t*y2;
      const sq=document.createElementNS('http://www.w3.org/2000/svg','rect'); sq.setAttribute('x',xt-3); sq.setAttribute('y',yt-3); sq.setAttribute('width','6'); sq.setAttribute('height','6'); sq.setAttribute('fill','#00FFAA'); sq.setAttribute('opacity','0.6'); sq.setAttribute('transform',`rotate(45 ${xt} ${yt})`); pathSvg.appendChild(sq);
