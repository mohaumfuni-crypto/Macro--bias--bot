<script>
// ===== PRESERVED CORE - LOCKED ARCHITECTURE - LIVE-DATA-ONLY UPGRADE =====
const TFs=['1M','5M','15M','1H','4H','1D'];
const INSTR=['BTCUSDT','PAXGUSDT','BTCUSDT']; // Binance live only - PAXG is gold proxy, no fake NAS100
// Mapping display names
const DISPLAY_MAP={BTCUSDT:'BTCUSDT', PAXGUSDT:'XAUUSD (PAXG)', 'BTCUSDT_2':'NAS100 (UNAVAILABLE)'};
let selectedInstr='BTCUSDT', selectedTF='5M';
let chart, candleSeries;
let candles={BTCUSDT:[],PAXGUSDT:[]};
let livePrice={BTCUSDT:null,PAXGUSDT:null};
let dataProvenance={BTCUSDT:{source:'BINANCE', symbol:'BTCUSDT', timeframe:'1M', lastUpdate:null, status:'CONNECTING', latency:null, freshness:null, retrieval:'WS+REST'}, PAXGUSDT:{source:'BINANCE', symbol:'PAXGUSDT', timeframe:'1M', lastUpdate:null, status:'CONNECTING', latency:null, freshness:null, retrieval:'REST'}};
let lastUpdate={}, connStatus={BTCUSDT:'CONNECTING',PAXGUSDT:'CONNECTING',NAS100:'UNAVAILABLE'};
let predictions=JSON.parse(localStorage.getItem('howza_forever_live_07')||'[]');
let activePred=null;
let modelVersion='HOWZA-DYNAMIC-0.7';
let isLive=true, isDegraded=false;

function initChart(){
  const el=document.getElementById('chart');
  chart=LightweightCharts.createChart(el,{layout:{background:{type:'solid',color:'#080c18'},textColor:'#8aa0bd'},grid:{vertLines:{color:'#132036'},horzLines:{color:'#132036'}},crosshair:{mode:1},rightPriceScale:{borderColor:'#1e2a44'},timeScale:{borderColor:'#1e2a44',timeVisible:true,secondsVisible:false},handleScroll:true,handleScale:true});
  candleSeries=chart.addCandlestickSeries({upColor:'#00FFAA',downColor:'#FF3B30',borderVisible:false,wickUpColor:'#00FFAA',wickDownColor:'#FF3B30'});
  window.addEventListener('resize',()=>chart.timeScale().fitContent());
}
function renderInstrBar(){
  const c=document.getElementById('instruments'); c.innerHTML='';
  const list=[{id:'BTCUSDT', label:'BTCUSDT'}, {id:'PAXGUSDT', label:'XAUUSD'}, {id:'NAS100', label:'NAS100'}];
  list.forEach(ins=>{
    const id=ins.id;
    const dot=connStatus[id]==='CONNECTED'?'live': connStatus[id]==='DEGRADED'?'degraded':'off';
    let price='---';
    if(id==='BTCUSDT') price=livePrice.BTCUSDT? livePrice.BTCUSDT.toLocaleString(): '---';
    else if(id==='PAXGUSDT') price=livePrice.PAXGUSDT? livePrice.PAXGUSDT.toFixed(2): '---';
    else price='UNAVAILABLE';
    const d=document.createElement('div'); d.className='instr'+(selectedInstr===id?' active':'');
    d.innerHTML=`<span class="dot ${dot}"></span><b>${ins.label}</b> <span class="price">${price}</span>`;
    if(id!=='NAS100'){
      d.onclick=()=>{selectedInstr=id; activePred=predictions.filter(p=>p.instrument===id&&p.lifecycle!=='RESOLVED').slice(-1)[0]||null; renderInstrBar(); renderAll();};
    }
    c.appendChild(d);
  });
}
function renderTFBar(){
  const c=document.getElementById('tfBar'); c.innerHTML='';
  TFs.forEach(tf=>{ const b=document.createElement('div'); b.className='pill'+(tf===selectedTF?' active':''); b.textContent=tf; b.onclick=()=>{selectedTF=tf; renderTFBar(); renderAll();}; c.appendChild(b); });
  const extra=document.createElement('div'); extra.style.display='flex'; extra.style.gap='4px'; extra.style.marginLeft='8px';
  extra.innerHTML=`<button class="pill2">LIQ</button><button class="pill2">FVG</button><button class="pill2">OB</button><button class="pill2">STRUCTURE</button><button class="pill2">S/D</button><button class="pill2">CORRELATION: UNAVAILABLE</button><button class="pill2">NEWS: UNAVAILABLE</button><button class="pill2 on" onclick="chart.timeScale().fitContent()">AUTO SCALE</button>`;
  c.appendChild(extra);
}

function aggregate(data, tf){
  if(tf==='1M'||!data) return data||[];
  const map={'5M':5,'15M':15,'1H':60,'4H':240,'1D':1440}; const n=map[tf]||1; const out=[];
  for(let i=0;i<data.length;i+=n){ const slice=data.slice(i,i+n).filter(c=>c&&typeof c.close==='number'); if(!slice.length) continue; out.push({time:slice[0].time, open:slice[0].open, high:Math.max(...slice.map(s=>s.high)), low:Math.min(...slice.map(s=>s.low)), close:slice[slice.length-1].close}); }
  return out;
}
function findSwings(data,l=2,r=2){
  const highs=[],lows=[];
  for(let i=l;i<data.length-r;i++){
    let ih=true,il=true;
    for(let j=1;j<=l;j++) if(data[i-j].high>=data[i].high) ih=false;
    for(let j=1;j<=r;j++) if(data[i+j].high>=data[i].high) ih=false;
    for(let j=1;j<=l;j++) if(data[i-j].low<=data[i].low) il=false;
    for(let j=1;j<=r;j++) if(data[i+j].low<=data[i].low) il=false;
    if(ih) highs.push({idx:i, price:data[i].high, time:data[i].time});
    if(il) lows.push({idx:i, price:data[i].low, time:data[i].time});
  }
  return {highs,lows};
}
function detectMarketRegime(data, vol, trend, premiumPct){
  // Evidence-based regime detection from live behavior
  if(vol>data[data.length-1].close*0.005) return 'HIGH VOLATILITY';
  if(vol<data[data.length-1].close*0.001) return 'LOW VOLATILITY COMPRESSION';
  if(trend==='RANGE' && vol<data[data.length-1].close*0.002) return 'RANGING COMPRESSION';
  if(trend!=='RANGE' && vol>data[data.length-1].close*0.003) return 'TRENDING EXPANSION';
  // Liquidity hunt detection: quick sweep and return
  if(data.length>=3){
    const last=data[data.length-1], prev=data[data.length-2];
    if(Math.abs(last.high-prev.high)/last.close>0.002 && Math.abs(last.close-last.high)>Math.abs(last.close-last.low)*2) return 'LIQUIDITY HUNT';
  }
  return trend==='RANGE'?'RANGING':`TRENDING ${trend}`;
}
function detectState(data){
  if(data.length<50) return null;
  const {highs,lows}=findSwings(data,2,2);
  const price=data[data.length-1].close;
  const daySlice=data.slice(-288);
  const pdh=daySlice.length? Math.max(...daySlice.map(d=>d.high)) : Math.max(...data.slice(-60).map(d=>d.high));
  const pdl=daySlice.length? Math.min(...daySlice.map(d=>d.low)) : Math.min(...data.slice(-60).map(d=>d.low));
  const range=pdh-pdl||price*0.02;
  const premiumPct=range? ((price-pdl)/range*100):50;
  const premium=premiumPct>70?'PREMIUM':premiumPct<30?'DISCOUNT':'EQUILIBRIUM';
  let trend='RANGE';
  if(data.length>30){
    const rh=Math.max(...data.slice(-20).map(d=>d.high)), ph=Math.max(...data.slice(-40,-20).map(d=>d.high));
    const rl=Math.min(...data.slice(-20).map(d=>d.low)), pl=Math.min(...data.slice(-40,-20).map(d=>d.low));
    if(rh>ph && rl>pl) trend='BULLISH'; else if(rh<ph && rl<pl) trend='BEARISH';
  }
  const atr=data.slice(-14).reduce((a,c,i,arr)=> i===0?0:a+Math.abs(c.close-arr[i-1].close),0)/14;
  const lastBody=Math.abs(data[data.length-1].close-data[data.length-1].open);
  const displacement=lastBody>atr*1.5;
  const vol=atr>price*0.004?'EXPANSION':atr>price*0.002?'BUILDING':'COMPRESSION';
  const regime=detectMarketRegime(data, atr, trend, premiumPct);
  const bsl=highs.filter(h=>h.price>price).slice(-6).map(h=>({price:h.price, type:'BSL', significance:0.85, distance:Math.abs(h.price-price)/price*100, time:h.time}));
  const ssl=lows.filter(l=>l.price<price).slice(-6).map(l=>({price:l.price, type:'SSL', significance:0.85, distance:Math.abs(l.price-price)/price*100, time:l.time}));
  const fvg=[]; for(let i=2;i<data.length;i++){ if(data[i-2].high < data[i].low) fvg.push({price:(data[i-2].high+data[i].low)/2, top:data[i].low, bottom:data[i-2].high, type:'BULL FVG', significance:0.6, distance:Math.abs((data[i-2].high+data[i].low)/2-price)/price*100}); if(data[i-2].low > data[i].high) fvg.push({price:(data[i].high+data[i-2].low)/2, top:data[i-2].low, bottom:data[i].high, type:'BEAR FVG', significance:0.6, distance:Math.abs((data[i].high+data[i-2].low)/2-price)/price*100}); }
  const eqh=[], eql=[];
  for(let i=0;i<bsl.length;i++) for(let j=i+1;j<bsl.length;j++) if(Math.abs(bsl[i].price-bsl[j].price)/bsl[i].price<0.001) eqh.push({price:(bsl[i].price+bsl[j].price)/2, type:'EQH', significance:0.85, distance:Math.abs((bsl[i].price+bsl[j].price)/2-price)/price*100});
  for(let i=0;i<ssl.length;i++) for(let j=i+1;j<ssl.length;j++) if(Math.abs(ssl[i].price-ssl[j].price)/ssl[i].price<0.001) eql.push({price:(ssl[i].price+ssl[j].price)/2, type:'EQL', significance:0.85, distance:Math.abs((ssl[i].price+ssl[j].price)/2-price)/price*100});
  const candidates=[
    ...bsl, ...ssl, ...eqh, ...eql,
    {price:pdh, type:'PDH', significance:0.9, distance:Math.abs(pdh-price)/price*100},
    {price:pdl, type:'PDL', significance:0.9, distance:Math.abs(pdl-price)/price*100},
    ...fvg.slice(-3)
  ].filter(c=>c.distance>=0.05 && c.distance<=3.5).sort((a,b)=>a.distance-b.distance);
  return {price, pdh,pdl, range, premium, premiumPct, trend, vol, displacement, atr, regime, bsl, ssl, fvg, eqh, eql, candidates, data};
}

function rankCandidates(state){
  if(!state) return [];
  return state.candidates.map(c=>{
    let score=0;
    score+= Math.max(0, 30 - c.distance*9);
    score+= c.significance*22;
    if(state.trend==='BULLISH' && c.price>state.price) score+=10;
    if(state.trend==='BEARISH' && c.price<state.price) score+=10;
    if(state.premium==='DISCOUNT' && c.price>state.price) score+=8;
    if(state.premium==='PREMIUM' && c.price<state.price) score+=8;
    if(state.displacement){
      if(state.trend==='BULLISH' && c.price>state.price) score+=12;
      if(state.trend==='BEARISH' && c.price<state.price) score+=12;
    }
    if(c.type.includes('PDH')||c.type.includes('PDL')) score+=6;
    // Historical hit rate evidence-based
    const similar=predictions.filter(p=>p.instrument===selectedInstr && p.primaryType===c.type);
    const hr=similar.length>=3? similar.filter(p=>p.outcome&& (p.outcome.includes('REACHED')||p.outcome.includes('SWEPT')||p.outcome.includes('ACCEPTED'))).length/similar.length : 0.5;
    score+=hr*14;
    const probReach=Math.max(0.15, 1 - c.distance/3.5);
    const probReject=c.distance<0.25?0.25:0.12;
    // Path quality: opposing liquidity
    const opposing=state.candidates.filter(o=> (c.price>state.price? o.price<state.price : o.price>state.price) && o.distance<c.distance).length;
    score-=opposing*3;
    return {...c, score, probReach, probReject, hitRate:hr, opposing, evidence:[`dist ${c.distance.toFixed(4)}%`,`${state.trend} ${c.price>state.price?'above':'below'}`,`${state.premium} ${state.premiumPct.toFixed(1)}%`,`${state.regime}`,`hist ${(hr*100).toFixed(0)}% n=${similar.length}`,`pathQuality opposing ${opposing}` ]};
  }).sort((a,b)=>b.score-a.score);
}

function generateNextDestination(force=false){
  const raw=candles[selectedInstr]||[];
  const data=aggregate(raw, selectedTF);
  if(data.length<40) return null;
  if(!isLive) return null; // LIVE DATA ONLY - no prediction when disconnected
  const state=detectState(data);
  if(!state || state.candidates.length===0) return null;
  const ranked=rankCandidates(state);
  if(ranked.length===0) return null;
  if(activePred && !force){
    const sameDest=Math.abs(ranked[0].price-activePred.destination)/activePred.destination*100<0.14;
    if(sameDest && ranked[0].score<activePred.score+14) return null; // anti-flicker threshold 0.14
    if(activePred.lifecycle==='PREDICTED' && Math.abs(state.price-activePred.destination)/state.price*100>0.4) return null;
  }
  const next=ranked[0];
  const alternatives=ranked.slice(1,4);
  const price=state.price;
  const dir=next.price>price?'BULLISH':'BEARISH';
  const opposite=ranked.filter(r=> dir==='BULLISH'? r.price<price : r.price>price).sort((a,b)=>a.distance-b.distance)[0];
  const invalidation=opposite? opposite.price*(dir==='BULLISH'?0.996:1.004) : (dir==='BULLISH'? price*0.992:price*1.008);
  const similar=predictions.filter(p=>p.instrument===selectedInstr && p.direction===dir && Math.abs(p.distance-next.distance)<0.6);
  let conf=38 + Math.min(40, next.score*0.65);
  let confLabel=`${conf.toFixed(1)}%`;
  if(similar.length>=5){
    const wr=similar.filter(p=>p.outcome&& (p.outcome.includes('REACHED')||p.outcome.includes('SWEPT')||p.outcome.includes('ACCEPTED'))).length/similar.length;
    conf=36 + wr*44;
    confLabel=`${conf.toFixed(1)}% (n=${similar.length} validated)`;
  } else if(similar.length<3){
    confLabel=`LOW CONFIDENCE — INSUFFICIENT SAMPLE (n=${similar.length}) ${conf.toFixed(0)}%`;
  }
  const grade=conf>70?'A+++':conf>60?'A++':conf>50?'A+':'B';
  const shouldSignal=conf>=55 && similar.length>=3 && next.significance>=0.75;
  const lastTime=data[data.length-1].time;
  const path=[
    {price:price, time:lastTime, label:`${price.toFixed(2)}`},
    {price:next.price, time:lastTime+ (selectedTF==='1M'?600: selectedTF==='5M'?1200:3600), label:`${next.type} ${next.price.toFixed(2)}`}
  ];
  const prov=dataProvenance[selectedInstr]||{};
  return {
    id:'HOWZA-'+selectedInstr+'-'+Date.now(),
    modelVersion, instrument:selectedInstr, tf:selectedTF, timestamp:new Date().toISOString(),
    reference:price, destination:next.price, destinationType:next.type, distance:next.distance, score:next.score,
    direction:dir, signal: shouldSignal? (dir==='BULLISH'?'BUY':'SELL'):null,
    confidence:conf, confidenceLabel:confLabel, grade, lifecycle:'PREDICTED', predictedPath:path,
    evidence:next.evidence, ranked, alternatives, primaryType:next.type, secondaryType:alternatives[0]?.type||'PDH',
    primaryPrice:next.price, secondaryPrice:alternatives[0]?.price||next.price, alternativePrice:alternatives[1]?.price||next.price, alternative2Price:alternatives[2]?.price||next.price,
    invalidation, invalidationType:opposite?opposite.type:'STRUCT', probReach:next.probReach, probReject:next.probReject, hitRate:next.hitRate,
    outcome:null, frozen:false, state, similarHistorical:similar.length,
    dataSource:prov.source||'BINANCE', dataTimestamp:prov.lastUpdate||new Date().toISOString(), dataProvenance:prov,
    maxFavorable:0, maxAdverse:0, timeToResolution:null
  };
}

function evaluateOutcome(pred, currentPrice, currentData){
  if(!pred || pred.lifecycle==='RESOLVED') return null;
  const price=currentPrice;
  const dest=pred.destination;
  const inv=pred.invalidation;
  const dist=Math.abs(price-dest)/price*100;
  if(pred.lifecycle==='PREDICTED' && dist<0.8) pred.lifecycle='APPROACHING';
  if(pred.lifecycle==='APPROACHING' && dist<0.15) pred.lifecycle='TESTED';
  const last3=currentData.slice(-3);
  const touched=last3.some(c=> (c.low<=dest && c.high>=dest) || Math.abs(c.close-dest)/dest*100<0.07);
  if(touched){
    const last=currentData[currentData.length-1];
    if(pred.direction==='BULLISH'){
      if(last.close>dest*1.001) pred.outcome='ACCEPTED - close above';
      else if(last.high>dest*1.002) pred.outcome='SWEPT - wick beyond';
      else if(last.close<dest) pred.outcome='REJECTED - wick then rejection';
      else pred.outcome='REACHED';
    } else {
      if(last.close<dest*0.999) pred.outcome='ACCEPTED - close below';
      else if(last.low<dest*0.998) pred.outcome='SWEPT - wick beyond';
      else if(last.close>dest) pred.outcome='REJECTED';
      else pred.outcome='REACHED';
    }
    const maxHigh=Math.max(...currentData.slice(-5).map(c=>c.high));
    const minLow=Math.min(...currentData.slice(-5).map(c=>c.low));
    if((pred.direction==='BULLISH' && maxHigh>dest*1.0035) || (pred.direction==='BEARISH' && minLow<dest*0.9965)) pred.outcome+=' + OVERSHOT';
    pred.lifecycle='RESOLVED'; pred.frozen=true; pred.outcomeTime=new Date().toISOString();
    pred.maxFavorable=Math.max(...currentData.slice(-10).map(c=> (c.high-pred.reference)/pred.reference*100*(pred.direction==='BULLISH'?1:-1)));
    pred.maxAdverse=Math.min(...currentData.slice(-10).map(c=> (c.low-pred.reference)/pred.reference*100*(pred.direction==='BULLISH'?1:-1)));
    return pred;
  }
  if((pred.direction==='BULLISH' && price<=inv) || (pred.direction==='BEARISH' && price>=inv)){
    pred.outcome='INVALIDATED - acceptance beyond invalidation'; pred.lifecycle='RESOLVED'; pred.frozen=true; pred.outcomeTime=new Date().toISOString(); return pred;
  }
  const idx=currentData.findIndex(c=>c.time===pred.predictedPath[0].time);
  if(idx>=0 && currentData.length-idx>30){
    pred.outcome='NEVER REACHED - expired 30 candles'; pred.lifecycle='RESOLVED'; pred.frozen=true; pred.outcomeTime=new Date().toISOString(); return pred;
  }
  return null;
}

function drawPrediction(pred, state){
  const zoneSvg=document.getElementById('zoneSvg'); const pathSvg=document.getElementById('pathSvg');
